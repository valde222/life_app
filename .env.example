# Copy to .env on the Pi and fill in. Never commit .env.
# PocketBase refuses to start in production with a password under 16 characters or an example value.
# Make passwords with: openssl rand -base64 24

# The one account the apps sign in with
PB_USER_EMAIL=you@example.com
PB_USER_PASSWORD=change-me

# Superuser for the admin UI (over SSH only) and the backup job
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-too

# Backups are encrypted with age before they leave PocketBase's folder.
# Make a key pair on your PC (not the Pi): age-keygen -o life-backup.key
# Put the public key (age1...) here and keep the .key file somewhere safe off the Pi.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-key
# Where nightly backups are copied (a mounted second disk or network share)
BACKUP_TARGET=/mnt/backup/life
BACKUP_KEEP_DAYS=14

# Tailscale Funnel (start with: docker compose --profile tunnel up -d)
TS_AUTHKEY=tskey-auth-replace-me
