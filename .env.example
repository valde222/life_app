# Copy to .env on the Pi and fill in. Never commit .env.

# The one account the apps sign in with
PB_USER_EMAIL=you@example.com
PB_USER_PASSWORD=change-me

# Superuser for the admin UI and the backup job
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-too

# Where nightly backups are copied (a mounted second disk or network share)
BACKUP_TARGET=/mnt/backup/life
BACKUP_KEEP_DAYS=14

# Tailscale Funnel (start with: docker compose --profile tunnel up -d)
TS_AUTHKEY=tskey-auth-...
