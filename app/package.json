{
  "name": "life-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "tokens": "node scripts/tokens.mjs",
    "diagrams": "node scripts/dependency-diagrams.mjs",
    "e2e": "playwright test",
    "e2e:docker": "./e2e/run-in-docker.sh",
    "build:android": "npm run build && npx cap sync android && cd android && cmd.exe /c \"gradlew.bat assembleDebug\"",
    "build:desktop": "npm run build && cd ../desktop && cmd.exe /c \"cargo tauri build\"",
    "lint": "npm run lint:ts && npm run lint:deps && npm run lint:styles && npm run lint:format",
    "lint:ts": "eslint .",
    "lint:format": "prettier --check .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:styles": "node scripts/check-styles.mjs"
  },
  "private": true,
  "packageManager": "npm@12.1.0",
  "dependencies": {
    "@angular/cdk": "22.2.5",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/local-notifications": "8.3.1",
    "@ebarooni/capacitor-calendar": "8.9.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "dexie": "4.4.6",
    "pocketbase": "0.28.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "angular-eslint": "22.6.0",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.1.2",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "rimraf": {
      "glob": "14.0.3"
    },
    "minimatch": "11.0.3"
  }
}
