{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Life",
  "version": "0.1.0",
  "identifier": "dk.ottes.life",
  "build": {
    "frontendDist": "../../app/dist/app/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "Life",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https: http://localhost:* http://127.0.0.1:* http://10.0.2.2:*; connect-src 'self' ipc: http://ipc.localhost https: wss: http://localhost:* http://127.0.0.1:* http://10.0.2.2:* ws://localhost:*; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'; worker-src 'self' blob:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg5M0ZEODJBNzhBMkY0NkUKUldSdTlLSjRLdGcvaVNBYWNFaFRoelFIVGJBcUo5bW01bERGNVhabktJOG83ZWdzZy9JY1NFQ3oK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
